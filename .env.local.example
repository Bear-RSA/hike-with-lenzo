# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Where enquiries are delivered (Lenzo's inbox)
ENQUIRY_TO_EMAIL=lenzo@example.com

# Sender. For testing you can use Resend's shared sender; for production
# verify your domain in Resend and use e.g. "Hiking with Lenzo <hello@hikingwithlenzo.co.za>"
ENQUIRY_FROM_EMAIL="Hiking with Lenzo <onboarding@resend.dev>"
